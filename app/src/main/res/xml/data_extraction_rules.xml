<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: explicit allowlists for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="otp_forwarder_database" />
        <include domain="database" path="otp_forwarder_database-wal" />
        <include domain="database" path="otp_forwarder_database-shm" />
        <include domain="sharedpref" path="forwarder_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="otp_forwarder_database" />
        <include domain="database" path="otp_forwarder_database-wal" />
        <include domain="database" path="otp_forwarder_database-shm" />
        <include domain="sharedpref" path="forwarder_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
